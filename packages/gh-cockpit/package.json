{
  "name": "@kud/gh-cockpit",
  "version": "0.14.10",
  "description": "A configurable GitHub cockpit for the terminal — your PRs, reviews and issues in one Ink TUI, grouped by whose move it is.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "github",
    "pull-request",
    "cli",
    "ink",
    "react",
    "terminal",
    "tui",
    "cockpit",
    "inbox"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/gh",
    "directory": "packages/gh-cockpit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ink": ">=7",
    "react": ">=19"
  },
  "dependencies": {
    "@kud/gh": "0.21.2",
    "@kud/gh-ink": "0.81.0",
    "@kud/ink-ui": "0.42.0",
    "zx": "8.8.5",
    "@kud/gh-workflow": "0.19.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "ink": "8.0.0",
    "ink-testing-library": "4.0.0",
    "react": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
