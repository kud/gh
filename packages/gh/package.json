{
  "name": "@kud/gh",
  "version": "0.9.0",
  "description": "Surface-agnostic GitHub core — gh CLI primitives, PR review comments, health, and webhook logic.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "pull-request",
    "code-review",
    "gh-cli",
    "graphql",
    "core"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/gh",
    "directory": "packages/gh"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "execa": "9.6.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
