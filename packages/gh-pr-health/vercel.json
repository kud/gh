{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "npm run demo:build",
  "outputDirectory": "demo",
  "rewrites": [
    {
      "source": "/projects/gh-pr-health/demo",
      "destination": "/index.html"
    },
    {
      "source": "/projects/gh-pr-health/demo/:path*",
      "destination": "/:path*"
    }
  ]
}
