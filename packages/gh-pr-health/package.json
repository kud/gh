{
  "name": "@kud/gh-pr-health",
  "version": "0.1.165",
  "description": "Checks, reviews and merge state for a GitHub PR in the terminal.",
  "type": "module",
  "bin": {
    "gh-pr-health": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "pull-request",
    "ci",
    "cli",
    "ink"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/gh",
    "directory": "packages/gh-pr-health"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kud/gh": "0.21.2",
    "@kud/gh-ink": "0.85.0",
    "@kud/ink-ui": "0.43.0",
    "execa": "10.2.1",
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3"
  }
}
